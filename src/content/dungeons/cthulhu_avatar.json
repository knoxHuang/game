    "sources": [
      {
        "title": "The Call of Cthulhu",
        "url": "https://www.hplovecraft.com/writings/texts/fiction/cc.aspx",
        "evidence": "原著雕像描述有触须头部、鳞质躯体、巨爪和翅膀；拉莱耶段落描写绿渍巨石、黏液、巨大门扉和异常几何。"
      }
    ],
    "interpretation": "克苏鲁化身为本游戏投影设定。世界海图以原著拉莱耶环境为依据；星核、星蚀招式与具体污染扩散方式是游戏改编，不将巨眼或引力漩涡当作原著固有特征。",
    "reviewed": false
  },
  "art": {
    "portrait": "/assets/bosses/cthulhu-avatar-mobile.webp",
    "card": null,
    "brief": "海图环境依据原著的绿渍巨石、黏液、巨大门扉与异常几何；化身、星核、污染扩散与战斗能力为游戏改编。不采用无来源的天空巨眼或蓝色引力涡。独立战区与完整动作资源仍待补齐。",
    "reviewed": false
  },
